import "../poseidon_hash/poseidon"
from "../curves/point" import Point
from "../curves/params" import CurveParams, VESTA_PARAMS
from "../signature/schnorr" import SchnorrSignature, verify

const u32 DOMAIN_SEPARATOR_HASH = 0
const u32 DOMAIN_SEPARATOR_COMMITMENT = 1
const u32 DOMAIN_SEPARATOR_SIGNATURE = 2
const u32 DOMAIN_SEPARATOR_PRF = 3

def generate_hash(field nonce,  field message_hash,  field tag,  field f,  field h) -> field:
    field[5] hash_inputs = [0; 5]
    hash_inputs[0] = nonce
    hash_inputs[1] = message_hash
    hash_inputs[2] = tag
    hash_inputs[3] = f
    hash_inputs[4] = h

    field hash_output = poseidon(hash_inputs, DOMAIN_SEPARATOR_HASH)

    return hash_output


def generate_prf(field k,  field nonce,  field message_hash) -> field:
    field[3] prf_inputs = [0; 3]
    prf_inputs[0] = k
    prf_inputs[1] = nonce
    prf_inputs[2] = message_hash

    field prf_output = poseidon(prf_inputs, DOMAIN_SEPARATOR_PRF)

    return prf_output


def hash_of_obj(field[4] st,  field h_regCbs,  field sn) -> field:
    field[6] hash_inputs = [...st, h_regCbs, sn]

    field hash_output = poseidon(hash_inputs, DOMAIN_SEPARATOR_HASH)

    return hash_output


// open(com, r) = k
def generate_commitment(field hash_obj, field gamma) -> field:
    field[2] com_inputs = [0; 2]
    com_inputs[0] = hash_obj
    com_inputs[1] = gamma

    field com_output = poseidon(com_inputs, DOMAIN_SEPARATOR_COMMITMENT)

    return com_output


def verify_com_sig(field pk_x, field pk_y, field com, field sign_r_x, field sign_r_y, field sign_s) -> field:
    Point pk = Point { x: pk_x, y: pk_y }
    Point sign_R = Point { x: sign_r_x, y: sign_r_y }
    SchnorrSignature sign = SchnorrSignature { R: sign_R, s: sign_s }

    field[1] sign_msg = [com]

    field result = verify(pk, sign_msg, sign, VESTA_PARAMS)

    return result


def main(private field pk_x, private field pk_y, \
    private field k, private field sn, \
    private field new_tok_nonce, private field new_tok_msg_hash, private field new_tok_tag, private field new_f, private field new_m, \
    private field[4] old_obj_st, private field old_obj_h_regCbs, private field old_obj_sn, \
    private field[4] new_obj_st, private field new_obj_h_regCbs, private field new_obj_sn, \
    private field old_gamma, private field old_com_obj, \
    private field new_gamma, private field new_com_obj, \
    private field[4] synced_st, private field synced_h_regCbs, \
    private field old_com_sig_r_x, private field old_com_sig_r_y, private field old_com_sig_s) -> field:
  field prf_res = generate_prf(k, new_tok_nonce, new_tok_msg_hash)
  assert(prf_res == new_tok_tag)

  // verify new_obj well-formedness
  field expected_new_obj_h_regcbs = generate_hash(new_tok_nonce, new_tok_msg_hash, new_tok_tag, new_f, old_obj_h_regCbs)
  assert(expected_new_obj_h_regcbs == new_obj_h_regCbs)

  // verify that the new object has the state synced from the synchronization phase.
  assert(new_obj_st[0] == synced_st[0])
  assert(new_obj_st[1] == synced_st[1])
  assert(new_obj_st[2] == synced_st[2])
  assert(new_obj_st[3] == synced_st[3])

  // verify the new object's commitment opens to the new object
  field hash_new_obj = hash_of_obj(new_obj_st, new_obj_h_regCbs, new_obj_sn)
  field expected_new_com_obj = generate_commitment(hash_new_obj, new_gamma)
  assert(expected_new_com_obj == new_com_obj)

  // verify the validity of obj
  // sn = old_obj_sn
  assert(sn == old_obj_sn)

  // verify that the old object's commitment is signed by the server
  field verify_sig_res = verify_com_sig(pk_x, pk_y, old_com_obj, old_com_sig_r_x, old_com_sig_r_y, old_com_sig_s)
  assert(verify_sig_res == 1)

  // verify that the old object's commitment opens to old object
  field hash_old_obj = hash_of_obj(old_obj_st, old_obj_h_regCbs, old_obj_sn)
  field expected_old_com_obj = generate_commitment(hash_old_obj, old_gamma)
  assert(expected_old_com_obj == old_com_obj)

  return 1