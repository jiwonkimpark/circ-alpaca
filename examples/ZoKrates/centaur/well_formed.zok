import "../poseidon_hash/poseidon"

const u32 DOMAIN_SEPARATOR_HASH = 0
const u32 DOMAIN_SEPARATOR_COMMITMENT = 1
const u32 DOMAIN_SEPARATOR_SIGNATURE = 2
const u32 DOMAIN_SEPARATOR_PRF = 3

def generate_hash(field nonce,  field message_hash,  field tag,  field h) -> field:
    field[4] hash_inputs = [0; 4]
    hash_inputs[0] = nonce
    hash_inputs[1] = message_hash
    hash_inputs[2] = tag
    hash_inputs[3] = h

    field hash_output = poseidon(hash_inputs, DOMAIN_SEPARATOR_HASH)

    return hash_output


def generate_prf(field k,  field nonce,  field message_hash) -> field:
    field[3] prf_inputs = [0; 3]
    prf_inputs[0] = k
    prf_inputs[1] = nonce
    prf_inputs[2] = message_hash

    field prf_output = poseidon(prf_inputs, DOMAIN_SEPARATOR_PRF)

    return prf_output


def hash_of_obj(field st,  field com_toks,  field com_cb,  field sn) -> field:
    field[4] hash_inputs = [0; 4]
    hash_inputs[0] = st
    hash_inputs[1] = com_toks
    hash_inputs[2] = com_cb
    hash_inputs[3] = sn

    field hash_output = poseidon(hash_inputs, DOMAIN_SEPARATOR_HASH)

    return hash_output


// open(com, r) = k
def generate_commitment(field hash_obj, field gamma) -> field:
    field[2] com_inputs = [0; 2]
    com_inputs[0] = hash_obj
    com_inputs[1] = gamma

    field com_output = poseidon(com_inputs, DOMAIN_SEPARATOR_COMMITMENT)

    return com_output


def hash_lr(field left, field right) -> field:
    field[2] hash_inputs = [0; 2]
    hash_inputs[0] = left
    hash_inputs[1] = right
    field hash_output = poseidon(hash_inputs, DOMAIN_SEPARATOR_HASH)

    return hash_output


def main(private field[32] path, private field[32] path_dir, private field k, private field obj_st, private field obj_com_toks, private field obj_com_cb, private field obj_sn, private field gamma, private field com_obj, private field new_obj_st, private field new_obj_com_toks, private field new_obj_com_cb, private field new_obj_sn, private field new_gamma, private field com_new_obj, private field st_updated, private field new_tok_nonce, private field new_tok_message_hash, private field new_tok_tag, private field rt_bb, private field old_sn) -> field:
  field prf_res = generate_prf(k, new_tok_nonce, new_tok_message_hash)
  field verify_prf = prf_res - new_tok_tag
  assert(verify_prf == 0)

  // verify new_obj well-formedness
  field com_res = generate_hash(new_tok_nonce, new_tok_message_hash, new_tok_tag, obj_com_toks)
  field verify_com_toks = com_res - new_obj_com_toks
  assert(verify_com_toks == 0)

  assert(new_obj_st == st_updated)

  // TODO: cb

  field hash_new_obj = hash_of_obj(new_obj_st, new_obj_com_toks, new_obj_com_cb, new_obj_sn)
  field com_new_obj_res = generate_commitment(hash_new_obj, new_gamma)
  field verify_com_new_obj = com_new_obj_res - com_new_obj
  assert(verify_com_new_obj == 0)

  // verify the validity of obj
  field hash_obj = hash_of_obj(obj_st, obj_com_toks, obj_com_cb, obj_sn)
  field merkle_res = hash_obj

  for field i in 0..32 do
    merkle_res = if path_dir[i] == 0 then hash_lr(path[i], merkle_res) else hash_lr(merkle_res, path[i]) fi
  endfor

  field verify_path = rt_bb - merkle_res
  assert(verify_path == 0)

  field com_obj_res = generate_commitment(hash_obj, gamma)
  field verify_com_obj = com_obj_res - com_obj
  assert(verify_com_obj == 0)

  assert(old_sn == obj_sn)

  return 0