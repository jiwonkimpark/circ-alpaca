import "../poseidon_hash/poseidon"

const u32 DOMAIN_SEPARATOR_HASH = 0
const u32 DOMAIN_SEPARATOR_COMMITMENT = 1
const u32 DOMAIN_SEPARATOR_SIGNATURE = 2
const u32 DOMAIN_SEPARATOR_PRF = 3


def hash_of_event(field nonce,  field message_hash,  field tag,  field args,  field h) -> field:
    field[5] hash_inputs = [0; 5]
    hash_inputs[0] = nonce
    hash_inputs[1] = message_hash
    hash_inputs[2] = tag
    hash_inputs[3] = args
    hash_inputs[4] = h

    field hash_output = poseidon(hash_inputs, DOMAIN_SEPARATOR_HASH)

    return hash_output


def hash_of_tok(field nonce,  field message_hash,  field tag, field h) -> field:
    field[4] hash_inputs = [0; 4]
    hash_inputs[0] = nonce
    hash_inputs[1] = message_hash
    hash_inputs[2] = tag
    hash_inputs[3] = h

    field hash_output = poseidon(hash_inputs, DOMAIN_SEPARATOR_HASH)

    return hash_output


def hash_of_leaf(field[5] leaf) -> field:
    field hash_output = poseidon(leaf, DOMAIN_SEPARATOR_HASH)

    return hash_output


def hash_lr(field left, field right) -> field:
    field[2] hash_inputs = [0; 2]
    hash_inputs[0] = left
    hash_inputs[1] = right
    field hash_output = poseidon(hash_inputs, DOMAIN_SEPARATOR_HASH)

    return hash_output


def generate_prf(field k,  field nonce,  field message_hash) -> field:
    field[3] prf_inputs = [0; 3]
    prf_inputs[0] = k
    prf_inputs[1] = nonce
    prf_inputs[2] = message_hash

    field prf_output = poseidon(prf_inputs, DOMAIN_SEPARATOR_PRF)

    return prf_output


def main(private field[32] path, private field[32] path_dir, private field k, private field t_last, private field root, private field tok_j_nonce, private field tok_j_message_hash, private field tok_j_tag, private field tok_j_h, private field tok_prev_nonce, private field tok_prev_message_hash, private field tok_prev_tag, private field tok_prev_h, private field st_update, private field st, private field[5] leaf, private field flag) -> field:
  field hash_of_tok_prev = hash_of_tok(tok_prev_nonce, tok_prev_message_hash, tok_prev_tag, tok_prev_h)
  bool tok_prev_is_last = (tok_j_nonce == 0) && (tok_j_message_hash == 0) && (tok_j_tag == 0) && (tok_j_h == 0)
  bool tok_j_is_first = (tok_prev_nonce == 0) && (tok_prev_message_hash == 0) && (tok_prev_tag == 0) && (tok_prev_h == 0)
  field verify_tok = if tok_prev_is_last then t_last - hash_of_tok_prev else if tok_j_is_first then 0 else tok_j_h - hash_of_tok_prev fi fi

  bool verify_leaf = if tok_prev_is_last then true else if flag == 0 then (tok_j_nonce == leaf[0]) && (tok_j_message_hash == leaf[1]) && (tok_j_tag == leaf[2]) else (leaf[0] < tok_j_tag) && (tok_j_tag < leaf[1]) fi fi

  field merkle_res = hash_of_leaf(leaf)

  for field i in 0..32 do
    merkle_res = if path_dir[i] == 0 then hash_lr(path[i], merkle_res) else hash_lr(merkle_res, path[i]) fi
  endfor

  field verify_path = if tok_prev_is_last then 0 else root - merkle_res fi
  field verify_st_update = if tok_prev_is_last then 0 else if flag == 0 then st_update - st - leaf[3] else st_update - st fi fi

  assert(verify_tok == 0)
  assert(verify_leaf)
  assert(verify_path == 0)
  assert(verify_st_update == 0)

  return 0

