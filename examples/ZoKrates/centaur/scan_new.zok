import "../poseidon_hash/poseidon"
from "../curves/point" import Point
from "../curves/params" import CurveParams, VESTA_PARAMS
from "../signature/schnorr" import SchnorrSignature, verify

const u32 DOMAIN_SEPARATOR_HASH = 0
const u32 DOMAIN_SEPARATOR_COMMITMENT = 1
const u32 DOMAIN_SEPARATOR_SIGNATURE = 2
const u32 DOMAIN_SEPARATOR_PRF = 3

def generate_prf(field k,  field nonce,  field message_hash, field msg_ts) -> field:
    field[4] prf_inputs = [0; 4]
    prf_inputs[0] = k
    prf_inputs[1] = nonce
    prf_inputs[2] = message_hash
    prf_inputs[3] = msg_ts

    field prf_output = poseidon(prf_inputs, DOMAIN_SEPARATOR_PRF)

    return prf_output


def hash_of_inv_entry(field nonce, field msg_hash, field tag, field msg_ts, field[2] args, field h, field ts, field sign_r_x, field sign_r_y, field sign_s) -> field:
    field[11] hash_inputs = [0; 11]
    hash_inputs[0] = nonce
    hash_inputs[1] = msg_hash
    hash_inputs[2] = tag
    hash_inputs[3] = msg_ts
    hash_inputs[4] = args[0]
    hash_inputs[5] = args[1]
    hash_inputs[6] = h
    hash_inputs[7] = ts
    hash_inputs[8] = sign_r_x
    hash_inputs[9] = sign_r_y
    hash_inputs[10] = sign_s

    field hash_output = poseidon(hash_inputs, DOMAIN_SEPARATOR_HASH)

    return hash_output


def verify_sig(field pk_x, field pk_y, field nonce, field msg_hash, field tag, field msg_ts, field[2] args, field h, field ts, field sign_r_x, field sign_r_y, field sign_s) -> field:
    Point pk = Point { x: pk_x, y: pk_y }
    Point sign_R = Point { x: sign_r_x, y: sign_r_y }
    SchnorrSignature sign = SchnorrSignature { R: sign_R, s: sign_s }

    field[8] sign_msg = [0; 8]
    sign_msg[0] = nonce
    sign_msg[1] = msg_hash
    sign_msg[2] = tag
    sign_msg[3] = msg_ts
    sign_msg[4] = args[0]
    sign_msg[5] = args[1]
    sign_msg[6] = h
    sign_msg[7] = ts

    field result = verify(pk, sign_msg, sign, VESTA_PARAMS)

    return result


def main(private field pk_x, private field pk_y, \
    private field k, \
    private field inv_i_nonce, private field inv_i_msg_hash, private field inv_i_tag, private field inv_i_msg_ts, private field[2] inv_i_args, private field inv_i_h, private field inv_i_ts, \
    private field inv_i_sign_r_x, private field inv_i_sign_r_y, private field inv_i_sign_s, \
    private field inv_prev_nonce, private field inv_prev_msg_hash, private field inv_prev_tag, private field inv_prev_msg_ts, private field[2] inv_prev_args, private field inv_prev_h, private field inv_prev_ts, \
    private field inv_prev_sign_r_x, private field inv_prev_sign_r_y, private field inv_prev_sign_s, \
    private field[4] st_i, private field[4] st_prev, \
    private field lock, private field[47] m_val, private field com_stat_wit\
    ) -> field:
    field joined = m_val[46]
    assert(joined == 1)
    assert(lock == 0)

    field hash_of_prev = hash_of_inv_entry(inv_prev_nonce, inv_prev_msg_hash, inv_prev_tag, inv_prev_msg_ts, inv_prev_args, inv_prev_h, inv_prev_ts, inv_prev_sign_r_x, inv_prev_sign_r_y, inv_prev_sign_s)
    assert(inv_i_h == hash_of_prev)

    field verify_sig_res = verify_sig(pk_x, pk_y, inv_i_nonce, inv_i_msg_hash, inv_i_tag, inv_i_msg_ts, inv_i_args, inv_i_h, inv_i_ts, inv_i_sign_r_x, inv_i_sign_r_y, inv_i_sign_s)
    assert(verify_sig_res == 1)

    bool should_consume_inv = generate_prf(k, inv_i_nonce, inv_i_msg_hash, inv_i_msg_ts) == inv_i_tag
    field is_update = if should_consume_inv then 1 else 0 fi
    field arg_is_0 = if inv_i_args[0] == 0 then 1 else 0 fi
    field arg_is_1 = if inv_i_args[0] == 1 then 1 else 0 fi
    field arg_is_2 = if inv_i_args[0] == 2 then 1 else 0 fi
    field arg_is_3 = if inv_i_args[0] == 3 then 1 else 0 fi

    // enforce boolean values
    assert(is_update * (1 - is_update) == 0)
    assert(arg_is_0 * (1 - arg_is_0) == 0)
    assert(arg_is_1 * (1 - arg_is_1) == 0)
    assert(arg_is_2 * (1 - arg_is_2) == 0)
    assert(arg_is_3 * (1 - arg_is_3) == 0)

    field is_ban   = is_update * arg_is_0
    field is_rep   = is_update * arg_is_1
    field is_vote  = is_update * arg_is_2
    field is_limit = is_update * arg_is_3

    field expected_ban = is_ban * inv_i_args[1] + (1 - is_ban) * st_prev[0]
    field expected_rep = is_rep * (inv_i_args[1] + st_prev[1]) + (1 - is_rep) * st_prev[1]
    field expected_vote = is_vote * (inv_i_args[1] + st_prev[2]) + (1 - is_vote) * st_prev[2]
    field expected_limit = is_limit * (st_prev[3] - inv_i_args[1]) + (1 - is_limit) * st_prev[3]

    assert(st_i[0] == expected_ban)
    assert(st_i[1] == expected_rep)
    assert(st_i[2] == expected_vote)
    assert(st_i[3] == expected_limit)

    field expected_com_stat_wit = poseidon(m_val, DOMAIN_SEPARATOR_HASH)
    assert(com_stat_wit == expected_com_stat_wit)

    return 1