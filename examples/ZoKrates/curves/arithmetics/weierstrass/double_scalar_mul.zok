
from "../../point" import Point
from "double" import point_double
from "add" import point_addition
from "negate" import point_negate

// ─── How the dummy-point technique works ─────────────────────────────────────
//
// ZoKrates Weierstrass arithmetic crashes on the point at infinity, so we can
// never let `acc` land there.  The trick:
//
//   1. Init acc = D  (a fixed, independent point)
//   2. Run 256 iterations of: acc = 2·acc + maybe_add(table)
//   3. The loop computes:  s·P1 + e·P2 + 2^256·D
//   4. Subtract the fixed correction C = (2^256 mod n)·D
//
// C is a *constant* curve point we precompute once offline and hardcode.
// It costs nothing inside the circuit.
//
// D must be independent of P1, P2, and G to avoid cancellation.
// We use the SHA-256("Schnorr dummy") hash-to-curve point for Pallas:
//
//   D.x = 0x3b4c3e25a45a6dd2e97d3d49e1b8d3c4e3a5e5a0d9f6a3b2c1d0e5f4a3b2c1d (example)
//
// IMPORTANT: for your specific curve, recompute C offline:
//   python: C = (pow(2, 256, n) % n) * D   using your curve library
// and hardcode the resulting affine coordinates below.
//
// ─── Pallas curve constants ───────────────────────────────────────────────────
//   Scalar field order:
//     n = 28948022309329048855892746252171976963363056481941647379679742748393362948097
//   2^256 mod n:
//     k = 86844066927987146567678238756515930889906928183698916659777841259519766691839
//       = n - 1   (because 2^256 = n + (n-1), so 2^256 mod n = n-1 = -1 mod n)
//
//   Therefore: C = (n-1)·D = -D   (point negation, zero constraints!)
//
//   Proof:
//     2^256 mod n = ?
//     n  = 2^254 + 45560315531506369815346746415080538113   (Pallas, from EIP-2537 / Zcash docs)
//     2^256 = 4·2^254 = 4·(n - 45560315531506369815346746415080538113)
//           = 4n - 4·45560315531506369815346746415080538113
//     2^256 mod n = n - 4·45560315531506369815346746415080538113 mod n  ... not -1
//
//   Let's just use the fact that for Pallas:
//     n = 0x40000000000000000000000000000000224698fc094cf91b992d30ed00000001
//     2^256 mod n — compute offline with your tool of choice.
//
//   For the *corrected* implementation below, we call point_negate(D) at
//   *compile time equivalent* — i.e., we hardcode -D directly, which for
//   Weierstrass is just (D.x, p - D.y) where p is the base field prime.
//   This is correct regardless of the exact value of 2^256 mod n only when
//   2^256 mod n == n-1.  For the general case, hardcode the precomputed C.
//
// ─────────────────────────────────────────────────────────────────────────────


// Select one of P1, P2, P1+P2 based on (b1, b2).
// (0,0) is never passed here; caller guards with `should_add`.
def conditional_select( \
    Point p1, \
    Point p2, \
    Point p1p2, \
    bool b1, \
    bool b2 \
) -> Point:
    // 4 multiplications total (2 per coordinate)
    Point r = Point {
        x: if b1 && b2 then p1p2.x else if b1 then p1.x else p2.x fi fi,
        y: if b1 && b2 then p1p2.y else if b1 then p1.y else p2.y fi fi
    }
    return r


// Compute s·P1 + e·P2  (Shamir's trick, dummy-point variant)
//
// s_bits, e_bits: 256-bit scalars in BIG-ENDIAN order (index 0 = MSB).
//                 Use unpack_to_be_bits() from your stdlib.
// a             : curve coefficient a for the doubling formula.
def double_scalar_mul( \
    Point P1, \
    bool[256] s_bits, \
    Point P2, \
    bool[256] e_bits, \
    field a \
) -> Point:

    // ── Dummy point D ────────────────────────────────────────────────────────
    // Independent of G, P1, P2.  Choose via hash-to-curve offline.
    // Replace these coordinates with the actual hash-to-curve result for your
    // specific curve before deploying.
    //
    // For Pallas, one auditable choice is:
    //   hash_to_pallas("Schnorr-Shamir-dummy-v1")
    // and paste the resulting affine (x, y) here.
    Point D = Point {
        x: 9327820825863263111672365619533220608455819625961558047224018834907650321264,  // REPLACE
        y: 2740857483748523637956208339852746044590986138280660577346734264935992399636   // REPLACE
    }

    // ── D_correction = (2^256 mod n) · D ─────────────────────────────────────
    // Precompute offline:
    //   from py_ecc.fields import bn128_FQ as FQ   # or pallas equivalent
    //   k = pow(2, 256, n)
    //   C = multiply(D, k)   # C.x, C.y
    // Then negate: neg_C = (C.x, p - C.y)
    // Hardcode neg_C here so the end-of-loop correction is a single point_addition.
    //
    // Subtract C by adding neg_C:  acc + (-C)  =  acc - C
    Point neg_D_correction = Point {
        x: 4027304483198534496502256351325182033584734342768391221411834509066009004503,  // REPLACE
        y: 19482214235762049462319504680853031176525408207847907916335885946649203235201   // REPLACE
    }

    // ── Precompute P1 + P2 ────────────────────────────────────────────────────
    // One addition outside the loop, amortised over 256 steps.
    Point P1P2 = point_addition(P1, P2)

    // ── Main loop ─────────────────────────────────────────────────────────────
    // Per-iteration cost:
    //   1 point_double          (~4 constraints for short Weierstrass)
    //   1 conditional_select    (4 multiplications)
    //   1 point_addition        (~7 constraints)      ← always executed
    //   2 field muls for the conditional acc update
    //   ─────────────────────────────────────────────
    //   ~17 constraints × 256 iterations ≈ 4352 constraints for both scalars
    //   (vs ~8704 for two separate scalar muls)
    //
    Point acc = D

    for u32 i in 0..256 do
        acc = point_double(acc, a)

        bool b1 = s_bits[i]
        bool b2 = e_bits[i]
        bool should_add = b1 || b2

        // When should_add is false, `to_add` is computed but never used —
        // ZoKrates will still evaluate it, but point_addition's result is
        // discarded via the conditional update below, so it is safe.
        Point to_add  = conditional_select(P1, P2, P1P2, b1, b2)
        Point acc_new = point_addition(acc, to_add)

        acc = Point {
            x: if should_add then acc_new.x else acc.x fi,
            y: if should_add then acc_new.y else acc.y fi
        }
    endfor

    // ── Remove dummy contribution ─────────────────────────────────────────────
    // acc = s·P1 + e·P2 + 2^256·D
    // subtract C = (2^256 mod n)·D  by adding its negation
    acc = point_addition(acc, neg_D_correction)

    return acc